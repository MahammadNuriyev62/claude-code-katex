"/* original css */ body { margin: 0; }
/* === KaTeX LaTeX Rendering CSS Patch === */
/* katex css mock */
.katex-display {
  margin: 0.5em 0;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 0.25em 0;
}
.katex-display > .katex {
  white-space: normal;
}
.katex {
  font-size: 1.1em;
}
.katex-source {
  display: block;
  position: relative;
}
.katex-source > .katex-display {
  padding-right: 2.25rem;
}
.katex-source-toggle {
  align-items: center;
  background: var(--vscode-button-secondaryBackground, rgba(127, 127, 127, 0.18));
  border: 1px solid var(--vscode-contrastBorder, transparent);
  border-radius: 4px;
  color: var(--vscode-foreground, currentColor);
  cursor: pointer;
  display: flex;
  height: 24px;
  justify-content: center;
  opacity: 0;
  padding: 0;
  position: absolute;
  right: 0.25rem;
  top: 0.25rem;
  transition: opacity 120ms ease;
  width: 30px;
  z-index: 1;
}
.katex-source:hover > .katex-source-toggle,
.katex-source:focus-within > .katex-source-toggle,
.katex-source-toggle[aria-expanded="true"] {
  opacity: 1;
}
.katex-source-toggle:hover {
  background: var(--vscode-button-secondaryHoverBackground, rgba(127, 127, 127, 0.28));
}
.katex-source-toggle:focus-visible {
  outline: 1px solid var(--vscode-focusBorder, currentColor);
  outline-offset: 2px;
}
.katex-source-toggle[aria-expanded="false"]::before {
  content: "TeX";
  font-family: var(--vscode-editor-font-family, monospace);
  font-size: 10px;
  font-weight: 600;
}
.katex-source-toggle[aria-expanded="true"]::before {
  border: 1.5px solid currentColor;
  border-radius: 70% 15%;
  content: "";
  height: 10px;
  transform: rotate(45deg);
  width: 10px;
}
.katex-source-toggle[aria-expanded="true"]::after {
  background: currentColor;
  border-radius: 50%;
  content: "";
  height: 4px;
  position: absolute;
  width: 4px;
}
.katex-source-code {
  background: var(--vscode-textCodeBlock-background, rgba(127, 127, 127, 0.12));
  border-radius: 4px;
  box-sizing: border-box;
  display: block;
  font-family: var(--vscode-editor-font-family, monospace);
  overflow-x: auto;
  padding: 0.75rem 2.5rem 0.75rem 0.75rem;
  white-space: pre;
  width: 100%;
}
.katex-source-code[hidden],
.katex-source > .katex-display[hidden] {
  display: none;
}
/* === End KaTeX CSS Patch === */"
