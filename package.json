{
  "name": "claude-code-katex",
  "displayName": "Claude Code LaTeX",
  "description": "Adds LaTeX math rendering to Claude Code chat — inline $...$, display $$...$$, and \\(...\\) / \\[...\\]",
  "version": "2.1.0",
  "publisher": "nuriyev",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MahammadNuriyev62/claude-code-katex.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "latex",
    "math",
    "mathematics",
    "equations",
    "katex",
    "claude",
    "claude-code",
    "anthropic",
    "markdown",
    "rendering"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-code-katex.enable",
        "title": "Claude Code LaTeX: Enable"
      },
      {
        "command": "claude-code-katex.disable",
        "title": "Claude Code LaTeX: Disable"
      },
      {
        "command": "claude-code-katex.status",
        "title": "Claude Code LaTeX: Status"
      },
      {
        "command": "claude-code-katex.reloadMacros",
        "title": "Claude Code LaTeX: Reload Macros"
      }
    ],
    "configuration": {
      "title": "Claude Code LaTeX",
      "properties": {
        "claudeCodeKatex.macroFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "LaTeX files whose macro definitions are made available to math in Claude Code chat — `\\newcommand`, `\\renewcommand`, `\\providecommand`, `\\def`, `\\let` and `\\DeclareMathOperator`. Anything else in the file (`\\usepackage`, prose, comments) is ignored, and a definition KaTeX cannot handle is skipped without affecting the others.\n\nSupports `~`, `${workspaceFolder}` and `${userHome}`; a relative path resolves against the first workspace folder.\n\nRun **Claude Code LaTeX: Reload Macros** after editing one of these files."
        },
        "claudeCodeKatex.macros": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Macros in KaTeX's own form, for a handful of definitions without a file — for example `{ \"\\\\RR\": \"\\\\mathbb{R}\", \"\\\\vv\": \"\\\\mathbf{#1}\" }`.\n\nApplied after `#claudeCodeKatex.macroFiles#`, so these win on a name defined by both."
        }
      }
    }
  },
  "scripts": {
    "test": "jest",
    "build:bundle": "esbuild v2-spike/entry.js --bundle --format=iife --minify --alias:katex=./v2-spike/katex-global-shim.js --outfile=vendor/remark-math-bundle.js",
    "vscode:uninstall": "node ./uninstall-hook.js"
  },
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "author": "",
  "bugs": {
    "url": "https://github.com/MahammadNuriyev62/claude-code-katex/issues"
  },
  "homepage": "https://github.com/MahammadNuriyev62/claude-code-katex#readme",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.25.0",
    "jest": "^30.3.0",
    "katex": "^0.16.11",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  }
}
